<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeepAwake.Viewer.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="主题" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="按所选方式自动切换 Windows 的浅色 / 深色主题（应用 + 系统），类似 PowerToys Light Switch。保存后约 10~15 秒内生效。" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <ToggleSwitch
                        x:Name="AutoThemeSwitch"
                        Header="自动切换日间/夜间主题"
                        OnContent="已开启"
                        OffContent="已关闭"
                        Toggled="AutoThemeSwitch_Toggled" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="开启后按下面的「切换方式」自动调整 Windows 主题；修改任何设置都会自动保存。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <ComboBox
                        x:Name="ModeComboBox"
                        Header="切换方式"
                        Width="380"
                        SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="自定义时间" Tag="fixed" />
                        <ComboBoxItem Content="日出日落（自动定位）" Tag="sunrise" />
                        <ComboBoxItem Content="日出日落（手动选择城市）" Tag="city" />
                        <ComboBoxItem Content="跟随 Windows 夜间模式" Tag="nightlight" />
                    </ComboBox>

                    <StackPanel x:Name="FixedPanel" Spacing="12">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TimePicker
                                x:Name="DayStartPicker"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="日间开始（切换浅色）"
                                ClockIdentifier="24HourClock"
                                TimeChanged="TimePicker_TimeChanged" />
                            <TimePicker
                                x:Name="NightStartPicker"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="夜间开始（切换深色）"
                                ClockIdentifier="24HourClock"
                                TimeChanged="TimePicker_TimeChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="LocationPanel" Spacing="10" Visibility="Collapsed">
                        <Button
                            x:Name="LocateButton"
                            Content="获取当前位置并计算日出日落"
                            Click="LocateButton_Click" />
                        <TextBlock
                            x:Name="LocationStatus"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="尚未获取位置。" />
                    </StackPanel>

                    <StackPanel x:Name="CityPanel" Spacing="10" Visibility="Collapsed">
                        <ComboBox
                            x:Name="CityComboBox"
                            Header="选择城市"
                            Width="380"
                            SelectionChanged="CityComboBox_SelectionChanged" />
                        <TextBlock
                            x:Name="CityStatus"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="选择城市后会自动计算当地的日出 / 日落时间。" />
                    </StackPanel>

                    <StackPanel x:Name="NightLightPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock
                            x:Name="NightLightStatus"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="读取 Windows 夜间模式状态中…" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="HintBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Title="说明" />

            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="所有修改都会自动保存；开启「自动切换日间/夜间主题」后约 10~15 秒内按新设置生效。" />
        </StackPanel>
    </ScrollViewer>
</Page>
