<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeepAwake.Viewer.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="常规" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="6">
                    <TextBlock Text="当前监测状态" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="MonitorStatusText"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Text="读取中…" />
                    <TextBlock
                        x:Name="MonitorStatusDetail"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="6">
                    <TextBlock Text="当前检测到的播放软件" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="PlayingAppsText"
                        TextWrapping="Wrap"
                        Text="读取中…" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="自动防息屏" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch
                        x:Name="AwakeSwitch"
                        Header="播放音视频时保持屏幕常亮"
                        OnContent="已开启"
                        OffContent="已关闭"
                        Toggled="AwakeSwitch_Toggled" />
                    <TextBlock
                        x:Name="AwakeHint"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="开启后检测到音乐 / 视频播放时保持屏幕常亮；没有播放时交给 Windows 电源管理。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="开机自动启动" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch
                        x:Name="AutoStartSwitch"
                        Header="登录 Windows 后自动在托盘运行"
                        OnContent="已开启"
                        OffContent="已关闭"
                        Toggled="AutoStartSwitch_Toggled" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="写入当前用户启动项 HKCU\...\Run\KeepAwake，不需要管理员权限。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="弹窗提醒" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch
                        x:Name="NotifySwitch"
                        Header="显示气泡 / 通知提醒"
                        OnContent="显示"
                        OffContent="不显示"
                        Toggled="NotifySwitch_Toggled" />
                    <TextBlock
                        x:Name="NotifyHint"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="关闭后不再显示启动、开关等气泡 / 通知提醒。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="阻止休眠的程序" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="列出当前正在阻止屏幕关闭 / 系统睡眠的程序（Windows 电源请求）。读取需要管理员权限，会弹出 UAC 提示。" />
                    <Button Content="查看当前电源请求" Click="OpenRequests_Click" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="GeneralInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Title="提示" />

            <TextBlock
                x:Name="RuntimeText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
