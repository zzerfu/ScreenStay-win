<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeepAwake.Viewer.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="6">
                    <TextBlock Text="ScreenStay" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Windows 托盘「智能保持屏幕常亮」工具，带 WinUI 3 主界面：音视频播放时保持常亮，并可自动切换日间 / 夜间主题。" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="6">
                    <TextBlock Text="路径与配置" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="PathText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="6">
                    <TextBlock Text="界面参考" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="主界面采用 WinUI 3 / Fluent Design，左侧导航布局参考 Auto Dark Mode（Windows Auto Night Mode）项目。" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="HintBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Title="提示" />
        </StackPanel>
    </ScrollViewer>
</Page>
