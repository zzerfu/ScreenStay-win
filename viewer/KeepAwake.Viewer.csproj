<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KeepAwake.Viewer</RootNamespace>
    <AssemblyName>ScreenStay.Viewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\icon-monitor.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.5.3</Version>
    <FileVersion>1.5.3.0</FileVersion>
    <AssemblyVersion>1.5.3.0</AssemblyVersion>
    <Product>ScreenStay</Product>
    <Description>ScreenStay WinUI 3 主界面（设置 / 主题 / 电源请求 / 使用说明）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与主程序共用的日出日落计算 / Windows 夜间模式解析 -->
    <Compile Include="..\shared\SunCalculator.cs" Link="Shared\SunCalculator.cs" />
    <Compile Include="..\shared\NightLightState.cs" Link="Shared\NightLightState.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只引用 WinUI 组件，避免把 AI / ML / Widgets 等无关组件打进输出；
         Runtime 用于框架依赖模式（需要系统已安装 Windows App Runtime） -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
  </ItemGroup>

</Project>
